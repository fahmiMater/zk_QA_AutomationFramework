# ------------------------------------------------------------------
# Environment template - copy to `.env` (or `.env.qa`, `.env.stage`)
# and fill in real values. NEVER commit real credentials.
# ------------------------------------------------------------------

# Backend host and service paths
API_BASE_URL="http://<backend-host>"
UM_SERVICE=":8112/user-management-service/api/v1"
GL_SERVICE=":8113/gl-management-service/api/v1"
CONFIG_SERVICE=":8111/config-management-service/api/v1"

# Default (admin) API user
API_USERNAME="<username>"
API_PASSWORD="<password>"

# Role-based users
ACCOUNTANT_USERNAME="<username>"
ACCOUNTANT_PASSWORD="<password>"

AUDITOR_USERNAME="<username>"
AUDITOR_PASSWORD="<password>"

# User without permissions (negative authorization tests)
UNAUTHORIZED_USER="<username>"
UNAUTHORIZED_PASSWORD="<password>"
