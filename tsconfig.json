  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": [
    "framework/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
